{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Waffle chart: 67 of 100 squares show the share of the world's glaciers projected to vanish by 2100.",
  "width": 240,
  "height": 240,
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "background": "transparent",
  "title": {
    "text": "Two in three glaciers may vanish by 2100",
    "subtitle": "Each square is 1% of the world's glaciers.",
    "fontSize": 13,
    "subtitleFontSize": 11,
    "anchor": "start",
    "offset": 10
  },
  "data": {
    "url": "data/glacier_vanish_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x": "number",
        "y": "number"
      }
    }
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#fbf8f2",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "y": {
      "field": "y",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Projected to vanish",
          "Not projected to vanish"
        ],
        "range": [
          "#48cae4",
          "#ddd6c8"
        ]
      },
      "legend": {
        "title": null,
        "labelFontSize": 11,
        "labelLimit": 240,
        "orient": "left",
        "direction": "vertical",
        "symbolType": "square"
      }
    },
    "tooltip": [
      {
        "field": "Category",
        "type": "nominal",
        "title": "Glaciers"
      }
    ]
  },
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "scale": {
      "bandPaddingInner": 0.12,
      "bandPaddingOuter": 0.02
    }
  }
}