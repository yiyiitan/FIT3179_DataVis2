{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 300,
  "padding": { "left": 4, "right": 4, "top": 4, "bottom": 10 },
  "background": "transparent",

  "data": { "sequence": { "start": 0, "stop": 100, "as": "i" } },

  "transform": [
    { "calculate": "datum.i % 10", "as": "col" },
    { "calculate": "floor(datum.i / 10)", "as": "row" },
    {
      "calculate": "datum.i < 67 ? 'Lost by 2100' : 'Still there in 2100'",
      "as": "Category"
    },
    {
      "calculate": "datum.i < 67 ? 'Projected to disappear by 2100' : 'Projected to survive to 2100'",
      "as": "Outcome"
    }
  ],

  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#fbf8f2",
    "strokeWidth": 1.5
  },

  "encoding": {
    "x": { "field": "col", "type": "ordinal", "axis": null },
    "y": { "field": "row", "type": "ordinal", "axis": null, "sort": "ascending" },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": ["Lost by 2100", "Still there in 2100"],
        "range": ["#163A5F", "#8EC8E8"]
      },
      "legend": {
        "title": "Each square = 1 in every 100 glaciers",
        "titleFontSize": 12,
        "titleFontWeight": 600,
        "titleColor": "#3a3a3a",
        "titlePadding": 8,
        "titleLimit": 300,
        "labelFontSize": 12,
        "labelColor": "#3a3a3a",
        "labelLimit": 260,
        "orient": "bottom",
        "direction": "horizontal",
        "symbolType": "square",
        "symbolSize": 160,
        "symbolStrokeWidth": 0,
        "columnPadding": 18,
        "offset": 14
      }
    },
    "tooltip": [
      { "field": "Outcome", "type": "nominal", "title": "This glacier" }
    ]
  },

  "config": {
    "font": "Inter, sans-serif",
    "background": "transparent",
    "view": { "stroke": "transparent" },
    "scale": { "bandPaddingInner": 0.1, "bandPaddingOuter": 0.02 }
  }
}