{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 300,
  "height": 300,
  "padding": {
    "left": 4,
    "right": 4,
    "top": 4,
    "bottom": 10
  },
  "background": "transparent",
  "data": {
    "url": "data/glacier_vanish_waffle.csv",
    "format": {
      "type": "csv",
      "parse": {
        "x": "number",
        "y": "number"
      }
    }
  },
  "mark": {
    "type": "rect",
    "cornerRadius": 3,
    "stroke": "#fbf8f2",
    "strokeWidth": 1
  },
  "encoding": {
    "x": {
      "field": "x",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "y": {
      "field": "y",
      "type": "ordinal",
      "axis": null,
      "sort": "ascending"
    },
    "color": {
      "field": "Category",
      "type": "nominal",
      "scale": {
        "domain": [
          "Projected to vanish",
          "Not projected to vanish"
        ],
        "range": [
          "#2f8fc9",
          "#ddd6c8"
        ]
      },
      "legend": {
        "title": null,
        "labelFontSize": 12,
        "labelLimit": 240,
        "orient": "bottom",
        "direction": "horizontal",
        "symbolType": "square",
        "offset": 12
      }
    },
    "tooltip": [
      {
        "field": "Category",
        "type": "nominal",
        "title": "Glaciers"
      }
    ]
  },
  "config": {
    "font": "Inter, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": "transparent"
    },
    "scale": {
      "bandPaddingInner": 0.12,
      "bandPaddingOuter": 0.02
    }
  }
}