{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 320,
  "height": 320,
  "background": "transparent",
  "title": {
    "text": "Where Malaysia's Emissions Come From",
    "subtitle": "Each square is 1%. Source: Climate Watch / GHG inventory.",
    "font": "sans-serif",
    "fontSize": 16,
    "subtitleFontSize": 12,
    "anchor": "start"
  },
  "data": {
    "url": "data/emissions_sector_share.csv",
    "format": {"type": "csv", "parse": {"share_pct": "number"}}
  },
  "params": [
    {
      "name": "sectorSelect",
      "select": {"type": "point", "fields": ["sector"]},
      "bind": "legend"
    }
  ],
  "transform": [
    {"calculate": "round(datum.share_pct)", "as": "blocks"},
    {"calculate": "sequence(1, datum.blocks + 1)", "as": "seq"},
    {"flatten": ["seq"]},
    {
      "window": [{"op": "row_number", "as": "id"}],
      "sort": [{"field": "share_pct", "order": "descending"}]
    },
    {"calculate": "floor((datum.id - 1) / 10)", "as": "row"},
    {"calculate": "(datum.id - 1) % 10", "as": "col"}
  ],
  "mark": {"type": "rect", "stroke": "white", "strokeWidth": 2, "cornerRadius": 3},
  "encoding": {
    "x": {"field": "col", "type": "ordinal", "axis": null},
    "y": {"field": "row", "type": "ordinal", "axis": null, "sort": "descending"},
    "opacity": {
      "condition": {"param": "sectorSelect", "value": 1, "empty": true},
      "value": 0.2
    },
    "color": {
      "field": "sector",
      "type": "nominal",
      "scale": {
        "domain": ["Energy", "Industrial", "Waste", "Agriculture"],
        "range": ["#8c510a", "#d6604d", "#4393c3", "#1a9850"]
      },
      "legend": {"title": "Sector", "orient": "bottom", "titleFontWeight": "bold"}
    },
    "tooltip": [
      {"field": "sector", "type": "nominal", "title": "Sector"},
      {"field": "share_pct", "type": "quantitative", "title": "Share (%)", "format": ".1f"}
    ]
  },
  "config": {"view": {"stroke": "transparent"}}
}
