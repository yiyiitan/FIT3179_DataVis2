{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Dot map of weather stations in Malaysia with station labels.",
  "width": "container",
  "height": 340,
  "background": "transparent",
  "autosize": {"type": "fit", "contains": "padding"},
  "projection": {
    "type": "mercator",
    "scale": 2500,
    "center": [109.5, 3.8]
  },
  "layer": [
    {
      "description": "Base Map Layer",
      "data": {
        "url": "data/dot_map.topojson",
        "format": {
          "type": "topojson",
          "feature": "countries"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ded7cb",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Station Locations Dot Layer",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "circle",
        "size": 90,
        "opacity": 0.9,
        "stroke": "#1f2937",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "record_span_years",
          "type": "quantitative",
          "title": "Record Span (Years)",
          "scale": {
            "scheme": "blues"
          },
          "legend": {
            "orient": "right",
            "offset": 5
          }
        },
        "tooltip": [
          {"field": "station_name", "type": "nominal", "title": "Station Name"},
          {"field": "elevation", "type": "quantitative", "title": "Elevation (m)"},
          {"field": "record_span_years", "type": "quantitative", "title": "Record Span (Years)"}
        ]
      }
    },
    {
      "description": "Station Name Labels",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "text",
        "fontSize": 8,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "middle",
        "dx": -23,
        "dy": -10,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "station_name",
          "type": "nominal"
        }
      }
    }
  ]
}