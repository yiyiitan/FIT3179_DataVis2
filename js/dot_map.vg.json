{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 340,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "projection": {
    "type": "mercator",
    "scale": {
      "expr": "min(width, 1000) * 2.6"
    },
    "center": [
      109.5,
      3.8
    ]
  },
  "layer": [
    {
      "description": "Base Map Layer",
      "data": {
        "url": "data/geoBoundaries-MYS-ADM1.topojson",
        "format": {
          "type": "topojson",
          "feature": "MYSADM1gbOpen"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "#ded7cb",
        "stroke": "#ffffff",
        "strokeWidth": 0.8
      }
    },
    {
      "description": "Station Locations Dot Layer",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "mark": {
        "type": "circle",
        "size": 110,
        "opacity": 0.9,
        "stroke": "#1f2937",
        "strokeWidth": 1
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "color": {
          "field": "record_span_years",
          "type": "quantitative",
          "title": "Years of records",
          "scale": {
            "range": [
              "#e6f7f8",
              "#b8e3e5",
              "#7acccf",
              "#3aaeb5",
              "#167a80"
            ]
          },
          "legend": {
            "orient": "right",
            "offset": 5,
            "titleFontSize": 12,
            "labelFontSize": 12
          }
        },
        "tooltip": [
          {
            "field": "station_name",
            "type": "nominal",
            "title": "Station"
          },
          {
            "field": "elevation",
            "type": "quantitative",
            "title": "Elevation (m)"
          },
          {
            "field": "record_span_years",
            "type": "quantitative",
            "title": "Years of records"
          }
        ]
      }
    },
    {
      "description": "Labels placed left of the dot",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "test(regexp('penang|sitiawan|abdul aziz|kota kinabalu|miri|bintulu|sibu|kuching','i'), datum.station_name)"
        },
        {
          "calculate": "replace(datum.station_name, regexp(' INTL$','i'), '')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "right",
        "baseline": "middle",
        "dx": -9,
        "dy": -5,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Labels placed right of the dot",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "test(regexp('ismail petra|kuantan|mersing|sandakan|tawau','i'), datum.station_name)"
        },
        {
          "calculate": "replace(datum.station_name, regexp(' INTL$','i'), '')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "dy": -5,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Labels placed below-left of the dot",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "test(regexp('kuala lumpur|malacca|melaka|labuan','i'), datum.station_name)"
        },
        {
          "calculate": "replace(datum.station_name, regexp(' INTL$','i'), '')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "right",
        "baseline": "middle",
        "dx": -9,
        "dy": 10,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Fallback labels for any other station",
      "data": {
        "url": "data/malaysia_weather_station_dot_map.csv",
        "format": {
          "type": "csv"
        }
      },
      "transform": [
        {
          "filter": "!test(regexp('penang|sitiawan|abdul aziz|kota kinabalu|miri|bintulu|sibu|kuching|ismail petra|kuantan|mersing|sandakan|tawau|kuala lumpur|malacca|melaka|labuan','i'), datum.station_name)"
        },
        {
          "calculate": "replace(datum.station_name, regexp(' INTL$','i'), '')",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "align": "left",
        "baseline": "middle",
        "dx": 9,
        "dy": -5,
        "color": "#1f2937"
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    }
  }
}