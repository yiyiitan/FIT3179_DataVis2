{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "Donut chart of global greenhouse gas emissions by sector. Percentages sit on the ring, so no labels overlap.",
  "width": 550,
  "height": 300,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 30,
    "right": 4,
    "top": 4,
    "bottom": 4
  },
  "layer": [
    {
      "description": "Ring, sorted from largest to smallest",
      "data": {
        "url": "data/global_ghg_emission_by_sector.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Percentage": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "(datum.Sector === 'Buildings' || datum.Sector === 'Waste') ? 'Buildings and waste' : datum.Sector",
          "as": "Group"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Percentage",
              "as": "Share"
            }
          ],
          "groupby": ["Group"]
        }
      ],
      "mark": {
        "type": "arc",
        "innerRadius": 70,
        "outerRadius": 130,
        "stroke": "#fbf8f2",
        "strokeWidth": 2
      },
      "encoding": {
        "theta": {
          "field": "Share",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "Share",
          "type": "quantitative",
          "sort": "descending"
        },
        "color": {
          "field": "Group",
          "type": "nominal",
          "title": null,
          "sort": [
            "Power Industry",
            "Transportation",
            "Industrial Combustion",
            "Agriculture",
            "Fuel Exploitation",
            "Buildings and waste",
            "Industrial Processes"
          ],
          "scale": {
            "domain": [
              "Power Industry",
              "Transportation",
              "Industrial Combustion",
              "Agriculture",
              "Fuel Exploitation",
              "Buildings and waste",
              "Industrial Processes"
            ],
            "range": [
              "#d55e00",
              "#0072b2",
              "#6a4c93",
              "#8c6239",
              "#b5446e",
              "#5c6b73",
              "#1b998b"
            ]
          },
          "legend": {
              "orient": "left",
              "direction": "vertical",
              "offset": -70,
              "symbolType": "square",
              "symbolSize": 150,
              "labelFontSize": 11,
              "labelLimit": 240
          }
        },
        "tooltip": [
          {
            "field": "Group",
            "type": "nominal",
            "title": "Sector"
          },
          {
            "field": "Share",
            "type": "quantitative",
            "title": "Share of emissions (%)",
            "format": ".1f"
          }
        ]
      }
    },
    {
      "description": "Percentages on the ring",
      "data": {
        "url": "data/global_ghg_emission_by_sector.csv",
        "format": {
          "type": "csv",
          "parse": {
            "Percentage": "number"
          }
        }
      },
      "transform": [
        {
          "calculate": "(datum.Sector === 'Buildings' || datum.Sector === 'Waste') ? 'Buildings and waste' : datum.Sector",
          "as": "Group"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Percentage",
              "as": "Share"
            }
          ],
          "groupby": ["Group"]
        },
        {
          "calculate": "format(datum.Share, '.0f') + '%'",
          "as": "Pct"
        }
      ],
      "mark": {
        "type": "text",
        "radius": 100,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#ffffff"
      },
      "encoding": {
        "theta": {
          "field": "Share",
          "type": "quantitative",
          "stack": true
        },
        "order": {
          "field": "Share",
          "type": "quantitative",
          "sort": "descending"
        },
        "text": {
          "field": "Pct",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Centre label, line 1",
      "data": {
        "values": [
          {
            "t": "Power plants:"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#4a3a30",
        "dy": -8
      },
      "encoding": {
        "x": {
          "datum": 0.5,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "y": {
          "datum": 0.5,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Centre label, line 2",
      "data": {
        "values": [
          {
            "t": "almost 1 in 3"
          }
        ]
      },
      "mark": {
        "type": "text",
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#4a3a30",
        "dy": 8
      },
      "encoding": {
        "x": {
          "datum": 0.5,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "y": {
          "datum": 0.5,
          "type": "quantitative",
          "scale": {
            "domain": [0, 1]
          },
          "axis": null
        },
        "text": {
          "field": "t",
          "type": "nominal"
        }
      }
    }
  ],
  "config": {
    "font": "Plus Jakarta Sans",
    "background": "transparent",
    "view": {
      "stroke": null,
      "continuousWidth": 100
    }
  }
}
