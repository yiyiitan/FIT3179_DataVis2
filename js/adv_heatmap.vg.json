{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 700, 
  "height": 250,
  "title": {
    "text": "A Century of Heat in Malaysia",
    "subtitle": "Monthly average temperature, 1901-2025. Source: World Bank CCKP.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 10
  },
  "background": "transparent",
  "data": {"url": "data/malaysia_monthly.csv"},
  "mark": {
    "type": "rect",
    "tooltip": true
  },
  "encoding": {
    "x": {
      "field": "Year", 
      "type": "ordinal",
      "axis": {"labelAngle": -45, "labelOverlap": true}
    },
    "y": {
      "field": "Month", 
      "type": "ordinal", 
      "sort": ["01", "02", "03", "04", "05", "06", "07", "08", "09", "10", "11", "12"],
      "scale": {"reverse": true}
    },
    "color": {
      "field": "Temperature", 
      "type": "quantitative", 
      "scale": {"scheme": "blueorange"},
      "title": "Avg Temp (°C)"
    },
    "tooltip": [
      {"field": "Year", "type": "ordinal"},
      {"field": "Month", "type": "ordinal"},
      {"field": "Temperature", "type": "quantitative", "title": "Temp (°C)"}
    ]
  }
}
