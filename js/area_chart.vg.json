{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 600,
  "height": 340,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 44,
    "top": 4,
    "bottom": 4
  },
  "data": {
    "url": "data/malaysia_ghg_gases.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "CO2": "number",
        "CH4": "number",
        "N2O": "number",
        "Fgases": "number"
      }
    }
  },
  "transform": [
    {
      "fold": [
        "CO2",
        "CH4",
        "N2O",
        "Fgases"
      ],
      "as": [
        "GasCode",
        "Raw"
      ]
    },
    {
      "calculate": "datum.GasCode === 'CO2' ? 'Carbon dioxide (CO₂)' : datum.GasCode === 'CH4' ? 'Methane (CH₄)' : datum.GasCode === 'N2O' ? 'Nitrous oxide (N₂O)' : 'F-gases (Cooling gases)'",
      "as": "Gas"
    },
    {
      "calculate": "datum.GasCode === 'CO2' ? 1 : datum.GasCode === 'CH4' ? 2 : datum.GasCode === 'N2O' ? 3 : 4",
      "as": "StackRank"
    },
    {
      "calculate": "toNumber(datum.Raw) / 1e6",
      "as": "Mt"
    },
    {
      "calculate": "datetime(toNumber(datum.Year), 0, 1)",
      "as": "date"
    }
  ],
  "layer": [
    {
      "description": "Stacked area by greenhouse gas",
      "mark": {
        "type": "area",
        "opacity": 0.92,
        "line": {
          "strokeWidth": 1,
          "color": "#ffffff"
        }
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "grid": false,
            "format": "%Y",
            "tickCount": {
              "interval": "year",
              "step": 10
            }
          }
        },
        "y": {
          "field": "Mt",
          "type": "quantitative",
          "title": "Million tonnes a year (CO₂ equivalent)",
          "stack": "zero",
          "scale": {
            "domain": [
              0,
              400
            ],
            "nice": false
          },
          "axis": {
            "grid": true,
            "gridColor": "#e6dfd2",
            "tickCount": 5,
            "labels": true,
            "ticks": true,
            "domain": true
          }
        },
        "color": {
          "field": "Gas",
          "type": "nominal",
          "title": null,
          "scale": {
            "domain": [
              "Carbon dioxide (CO₂)",
              "Methane (CH₄)",
              "Nitrous oxide (N₂O)",
              "F-gases (Cooling gases)"
            ],
            "range": [
              "#4d4d4d",
              "#f6ae2d",
              "#86bbd8",
              "#d291bc"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "symbolType": "square",
            "columns": 2,
            "labelLimit": 260
          }
        },
        "order": {
          "field": "StackRank",
          "type": "quantitative"
        },
        "tooltip": [
          {
            "field": "Year",
            "type": "ordinal",
            "title": "Year"
          },
          {
            "field": "Gas",
            "type": "nominal",
            "title": "Gas"
          },
          {
            "field": "Mt",
            "type": "quantitative",
            "format": ".1f",
            "title": "Million tonnes"
          }
        ],
        "opacity": {
          "condition": {
            "param": "gasSelect",
            "value": 0.95
          },
          "value": 0.18
        }
      },
      "params": [
        {
          "name": "gasSelect",
          "select": {
            "type": "point",
            "fields": [
              "Gas"
            ]
          },
          "bind": "legend"
        }
      ]
    },
    {
      "description": "Dotted leader lines for 1997, 2015 and 2020",
      "transform": [
        {
          "filter": "datum.Year === 1997 || datum.Year === 2015 || datum.Year === 2020"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Mt",
              "as": "total"
            }
          ],
          "groupby": [
            "Year",
            "date"
          ]
        },
        {
          "calculate": "390",
          "as": "ytop"
        }
      ],
      "mark": {
        "type": "rule",
        "color": "#2b2b2b",
        "strokeWidth": 1,
        "strokeDash": [
          3,
          3
        ],
        "opacity": 0.7
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "total",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ],
            "nice": false
          }
        },
        "y2": {
          "field": "ytop"
        }
      }
    },
    {
      "description": "Year line of the 1997 and 2015 labels (left of the line)",
      "transform": [
        {
          "filter": "datum.Year === 1997 || datum.Year === 2015"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Mt",
              "as": "total"
            }
          ],
          "groupby": [
            "Year",
            "date"
          ]
        },
        {
          "calculate": "390",
          "as": "ytop"
        },
        {
          "calculate": "toString(datum.Year)",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2b2b",
        "align": "right",
        "baseline": "top",
        "dy": 4,
        "dx": -4
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "ytop",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ],
            "nice": false
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Event line of the 1997 and 2015 labels (left of the line)",
      "transform": [
        {
          "filter": "datum.Year === 1997 || datum.Year === 2015"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Mt",
              "as": "total"
            }
          ],
          "groupby": [
            "Year",
            "date"
          ]
        },
        {
          "calculate": "390",
          "as": "ytop"
        },
        {
          "calculate": "datum.Year === 1997 ? 'Kyoto climate treaty' : 'Paris Agreement'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2b2b",
        "align": "right",
        "baseline": "top",
        "dy": 18,
        "dx": -4
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "ytop",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ],
            "nice": false
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Year line of the 2020 label (right of the line, no overlap)",
      "transform": [
        {
          "filter": "datum.Year === 2020"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Mt",
              "as": "total"
            }
          ],
          "groupby": [
            "Year",
            "date"
          ]
        },
        {
          "calculate": "390",
          "as": "ytop"
        },
        {
          "calculate": "'2020'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2b2b",
        "align": "left",
        "baseline": "top",
        "dy": 4,
        "dx": 5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "ytop",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ],
            "nice": false
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    },
    {
      "description": "Event line of the 2020 label (right of the line, no overlap)",
      "transform": [
        {
          "filter": "datum.Year === 2020"
        },
        {
          "aggregate": [
            {
              "op": "sum",
              "field": "Mt",
              "as": "total"
            }
          ],
          "groupby": [
            "Year",
            "date"
          ]
        },
        {
          "calculate": "390",
          "as": "ytop"
        },
        {
          "calculate": "'COVID-19'",
          "as": "label"
        }
      ],
      "mark": {
        "type": "text",
        "fontSize": 12,
        "color": "#2b2b2b",
        "align": "left",
        "baseline": "top",
        "dy": 18,
        "dx": 5
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal"
        },
        "y": {
          "field": "ytop",
          "type": "quantitative",
          "scale": {
            "domain": [
              0,
              400
            ],
            "nice": false
          }
        },
        "text": {
          "field": "label",
          "type": "nominal"
        }
      }
    }
  ],
  "resolve": {
    "scale": {
      "x": "shared",
      "y": "shared"
    }
  },
  "config": {
    "font": "Inter, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFontSize": 12,
      "titleFontSize": 12,
      "labelColor": "#4d4d4d",
      "titleColor": "#4d4d4d",
      "domainColor": "#b8b8b8",
      "tickColor": "#b8b8b8"
    },
    "legend": {
      "labelFontSize": 12
    }
  }
}