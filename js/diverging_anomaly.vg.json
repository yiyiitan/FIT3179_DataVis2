{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 640,
  "height": 300,
  "background": "transparent",
  "title": {
    "text": "Malaysia Crossed Into Warming Around 2000",
    "subtitle": "Annual anomaly vs 1991-2020. Source: OWID / Copernicus ERA5.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 14
  },
  "data": {
    "url": "data/malaysia_annual_anomaly.csv",
    "format": {"type": "csv", "parse": {"Year": "number", "Anomaly": "number"}}
  },
  "mark": {"type": "bar"},
  "encoding": {
    "x": {
      "field": "Year",
      "type": "ordinal",
      "axis": {"values": [1940, 1950, 1960, 1970, 1980, 1990, 2000, 2010, 2020], "labelAngle": 0, "labelFontSize": 11, "title": null}
    },
    "y": {
      "field": "Anomaly",
      "type": "quantitative",
      "title": "Temperature anomaly (°C)",
      "axis": {"titleFontSize": 13}
    },
    "color": {
      "field": "Anomaly",
      "type": "quantitative",
      "scale": {"scheme": "redblue", "reverse": true, "domainMid": 0},
      "legend": {"title": "Anomaly (°C)", "orient": "right"}
    },
    "tooltip": [
      {"field": "Year", "type": "ordinal"},
      {"field": "Anomaly", "type": "quantitative", "title": "Anomaly (°C)", "format": ".2f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"domainColor": "#B7B0A6", "tickColor": "#B7B0A6", "labelColor": "#4F4A43", "titleColor": "#4F4A43", "gridColor": "#E7E1D8"},
    "title": {"color": "#38362F"}
  }
}
