{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": "container",
  "height": 330,
  "background": "transparent",
  "autosize": {
    "type": "fit",
    "contains": "padding"
  },
  "padding": {
    "left": 4,
    "right": 4,
    "top": 20,
    "bottom": 4
  },
  "data": {
    "url": "data/cases_heat_illness.csv",
    "format": {
      "type": "csv",
      "parse": {
        "cases": "number"
      }
    }
  },
  "layer": [
    {
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 3,
        "width": {
          "band": 0.7
        }
      },
      "encoding": {
        "x": {
          "field": "illness",
          "type": "nominal",
          "title": "Type of Heat Illness",
          "sort": [
            "Heat exhaustion",
            "Heat cramps",
            "Heat stroke"
          ],
          "axis": {
            "ticks": false,
            "domain": true,
            "labelAngle": 0
          }
        },
        "y": {
          "field": "cases",
          "type": "quantitative",
          "title": "Reported Cases (Count)",
          "scale": {
            "domain": [
              0,
              150
            ]
          },
          "axis": {
            "grid": false,
            "tickCount": 4
          }
        },
        "color": {
          "field": "illness",
          "type": "nominal",
          "scale": {
            "domain": [
              "Heat exhaustion",
              "Heat cramps",
              "Heat stroke"
            ],
            "range": [
              "#F6B08A",
              "#E97963",
              "#B84A62"
            ]
          },
          "legend": {
            "orient": "top",
            "direction": "horizontal",
            "title": null,
            "legendX": 0,
            "legendY": 0,
            "offset": 5,
            "labelFontSize": 13,
            "symbolType": "square",
            "symbolSize": 90
          }
        },
        "tooltip": [
          {
            "field": "illness",
            "type": "nominal",
            "title": "Illness"
          },
          {
            "field": "cases",
            "type": "quantitative",
            "title": "Cases"
          }
        ]
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -4,
        "fontSize": 13,
        "fontWeight": "bold"
      },
      "encoding": {
        "x": {
          "field": "illness",
          "type": "nominal",
          "sort": [
            "Heat exhaustion",
            "Heat cramps",
            "Heat stroke"
          ]
        },
        "y": {
          "field": "cases",
          "type": "quantitative"
        },
        "text": {
          "field": "cases",
          "type": "quantitative"
        }
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "baseline": "bottom",
        "dy": -24,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#a4133c"
      },
      "encoding": {
        "x": {
          "datum": "Heat stroke"
        },
        "y": {
          "datum": 22
        },
        "text": {
          "value": "Life-Threatening"
        }
      }
    }
  ],
  "config": {
    "font": "Inter, sans-serif",
    "background": "transparent",
    "view": {
      "stroke": null
    },
    "axis": {
      "titleFontSize": 14,
      "labelFontSize": 13
    }
  }
}