{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 640,
  "height": 340,
  "background": "transparent",
  "title": {
    "text": "Five Decades of Malaysia's Greenhouse Gases",
    "subtitle": "Emissions by gas, 1970-2024. Source: Climate Watch / Malaysia GHG inventory.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 14
  },
  "data": {
    "url": "data/malaysia_ghg_gases.csv",
    "format": {"type": "csv"}
  },
  "params": [
    {
      "name": "gas_highlight",
      "select": {"type": "point", "fields": ["GasLabel"]},
      "bind": "legend"
    }
  ],
  "transform": [
    {"fold": ["CO2", "CH4", "N2O", "Fgases"], "as": ["Gas", "Emissions"]},
    {"calculate": "datum.Emissions / 1000000", "as": "EmissionsMt"},
    {
      "calculate": "{'CO2':'Carbon dioxide','CH4':'Methane','N2O':'Nitrous oxide','Fgases':'Fluorinated gases'}[datum.Gas]",
      "as": "GasLabel"
    }
  ],
  "mark": {"type": "area", "interpolate": "monotone"},
  "encoding": {
    "opacity": {
      "condition": {"param": "gas_highlight", "value": 1},
      "value": 0.25
    },
    "x": {
      "field": "Year",
      "type": "temporal",
      "timeUnit": "year",
      "title": null,
      "axis": {"format": "%Y", "labelFontSize": 11}
    },
    "y": {
      "field": "EmissionsMt",
      "type": "quantitative",
      "stack": "center",
      "axis": null,
      "title": "Emissions (Mt CO₂e)"
    },
    "color": {
      "field": "GasLabel",
      "type": "nominal",
      "scale": {
        "domain": ["Carbon dioxide", "Methane", "Nitrous oxide", "Fluorinated gases"],
        "range": ["#8c510a", "#d6604d", "#f4a582", "#4393c3"]
      },
      "legend": {"title": "Greenhouse gas", "orient": "bottom", "titleFontWeight": "bold"}
    },
    "tooltip": [
      {"field": "Year", "type": "temporal", "timeUnit": "year", "title": "Year"},
      {"field": "GasLabel", "type": "nominal", "title": "Gas"},
      {"field": "EmissionsMt", "type": "quantitative", "title": "Emissions (Mt CO₂e)", "format": ".1f"}
    ]
  },
  "config": {
    "view": {"stroke": null},
    "axis": {"domainColor": "#B7B0A6", "tickColor": "#B7B0A6", "labelColor": "#4F4A43", "titleColor": "#4F4A43"},
    "title": {"color": "#38362F"}
  }
}
