{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 400,
  "height": 400,
  "background": "transparent",
  "title": {
    "text": "Every Month Is Hotter Than Before",
    "subtitle": "Monthly average by era. Source: World Bank CCKP (ERA5).",
    "fontSize": 17,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 14
  },
  "data": {
    "url": "data/monthly_eras.csv",
    "format": {"type": "csv", "parse": {"Temperature": "number", "Month": "number"}}
  },
  "transform": [
    {"calculate": "(datum.Month - 1) / 12 * 2 * PI", "as": "angle"},
    {"calculate": "(datum.Temperature - 24.5)", "as": "r"},
    {"calculate": "datum.r * sin(datum.angle)", "as": "x"},
    {"calculate": "datum.r * cos(datum.angle)", "as": "y"}
  ],
  "encoding": {
    "x": {
      "field": "x",
      "type": "quantitative",
      "scale": {"domain": [-4, 4]},
      "axis": null
    },
    "y": {
      "field": "y",
      "type": "quantitative",
      "scale": {"domain": [-4, 4]},
      "axis": null
    },
    "color": {
      "field": "Era",
      "type": "nominal",
      "scale": {"domain": ["1901-1930", "1996-2025"], "range": ["#9CB4C0", "#B85C45"]},
      "legend": {"title": "Era", "orient": "bottom", "titleFontWeight": "bold"}
    }
  },
  "layer": [
    {
      "mark": {"type": "line", "interpolate": "linear-closed", "strokeWidth": 2.5, "opacity": 0.9},
      "encoding": {"order": {"field": "Month", "type": "ordinal"}}
    },
    {
      "mark": {"type": "point", "filled": true, "size": 70, "opacity": 1, "stroke": "white", "strokeWidth": 0.8},
      "encoding": {
        "tooltip": [
          {"field": "MonthName", "type": "nominal", "title": "Month"},
          {"field": "Era", "type": "nominal"},
          {"field": "Temperature", "type": "quantitative", "title": "Avg temp (°C)", "format": ".2f"}
        ]
      }
    },
    {
      "data": {
        "values": [
          {"MonthName": "Jan", "m": 1}, {"MonthName": "Feb", "m": 2}, {"MonthName": "Mar", "m": 3},
          {"MonthName": "Apr", "m": 4}, {"MonthName": "May", "m": 5}, {"MonthName": "Jun", "m": 6},
          {"MonthName": "Jul", "m": 7}, {"MonthName": "Aug", "m": 8}, {"MonthName": "Sep", "m": 9},
          {"MonthName": "Oct", "m": 10}, {"MonthName": "Nov", "m": 11}, {"MonthName": "Dec", "m": 12}
        ]
      },
      "transform": [
        {"calculate": "(datum.m - 1) / 12 * 2 * PI", "as": "angle"},
        {"calculate": "3.6 * sin(datum.angle)", "as": "x"},
        {"calculate": "3.6 * cos(datum.angle)", "as": "y"}
      ],
      "mark": {"type": "text", "fontSize": 11, "fontWeight": "bold", "color": "#6b6b61"},
      "encoding": {
        "x": {"field": "x", "type": "quantitative"},
        "y": {"field": "y", "type": "quantitative"},
        "text": {"field": "MonthName", "type": "nominal"}
      }
    }
  ],
  "config": {"view": {"stroke": null}, "title": {"color": "#38362F"}}
}
