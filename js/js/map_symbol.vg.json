{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 400,
  "title": {
    "text": "How Warm Major Cities Run",
    "subtitle": "Symbol size shows city's state average. Source: World Bank CCKP.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 12
  },
  "background": "transparent",
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/malaysia_dot_symbol.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white",
        "strokeWidth": 1.5
      }
    },
    {
      "data": {
        "url": "data/weather_stations.csv",
        "format": {"type": "csv", "parse": {"Latitude": "number", "Longitude": "number", "AvgTemp": "number"}}
      },
      "params": [
        {
          "name": "cityHover",
          "select": {
            "type": "point",
            "fields": ["Station"],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "point",
        "filled": true,
        "stroke": "white",
        "strokeWidth": 0.6
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {
          "field": "Station",
          "type": "nominal"
        },
        "size": {
          "field": "AvgTemp",
          "type": "quantitative",
          "scale": {"domain": [25, 28], "range": [60, 600]},
          "title": "Avg Temp (°C)"
        },
        "color": {
          "field": "AvgTemp",
          "type": "quantitative",
          "scale": {"scheme": "yelloworangered", "domain": [25, 28]},
          "legend": null
        },
        "opacity": {
          "condition": {"param": "cityHover", "value": 1, "empty": true},
          "value": 0.3
        },
        "order": {"field": "AvgTemp", "type": "quantitative", "sort": "descending"},
        "tooltip": [
          {"field": "Station", "type": "nominal", "title": "City"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "AvgTemp", "type": "quantitative", "title": "State avg temp (°C)", "format": ".2f"}
        ]
      }
    },
    {
      "data": {
        "url": "data/weather_stations.csv",
        "format": {"type": "csv", "parse": {"Latitude": "number", "Longitude": "number"}}
      },
      "transform": [
        {"filter": "test(/Kuala Lumpur|George Town/i, datum.Station)"}
      ],
      "mark": {
        "type": "text",
        "align": "left",
        "dx": 14,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {"field": "Station", "type": "nominal"}
      }
    },
    {
      "data": {
        "url": "data/weather_stations.csv",
        "format": {"type": "csv", "parse": {"Latitude": "number", "Longitude": "number"}}
      },
      "transform": [
        {"filter": "test(/Petaling/i, datum.Station)"}
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -14,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {"field": "Station", "type": "nominal"}
      }
    }
  ]
}