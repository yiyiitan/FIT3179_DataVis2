{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "width": 800,
  "height": 400,
  "background": "transparent",
  "title": {
    "text": "How Each City Compares to the Nation",
    "subtitle": "Difference from national average. Source: World Bank CCKP.",
    "fontSize": 18,
    "subtitleFontSize": 12,
    "anchor": "start",
    "offset": 12
  },
  "projection": {
    "type": "mercator"
  },
  "layer": [
    {
      "data": {
        "url": "data/malaysia_dot_symbol.topojson",
        "format": {"type": "topojson", "feature": "states"}
      },
      "mark": {
        "type": "geoshape",
        "fill": "#e8e4da",
        "stroke": "white",
        "strokeWidth": 1.2
      }
    },
    {
      "data": {
        "url": "data/weather_stations.csv",
        "format": {
          "type": "csv",
          "parse": {"Latitude": "number", "Longitude": "number", "AvgTemp": "number"}
        }
      },
      "transform": [
        {"calculate": "datum.AvgTemp - 26.29", "as": "TempDiff"},
        {"calculate": "datum.Longitude > 109 ? 'East Malaysia' : 'Peninsular Malaysia'", "as": "Region"}
      ],
      "params": [
        {
          "name": "dotHover",
          "select": {
            "type": "point",
            "fields": ["Station"],
            "on": "mouseover",
            "clear": "mouseout"
          }
        }
      ],
      "mark": {
        "type": "circle",
        "size": 180,
        "stroke": "white",
        "strokeWidth": 0.8
      },
      "encoding": {
        "longitude": {"field": "Longitude", "type": "quantitative"},
        "latitude": {"field": "Latitude", "type": "quantitative"},
        "text": {
          "field": "Station",
          "type": "nominal"
        },
        "opacity": {
          "condition": {"param": "dotHover", "value": 1, "empty": true},
          "value": 0.3
        },
        "color": {
          "field": "TempDiff",
          "type": "quantitative",
          "scale": {
            "scheme": "redblue",
            "reverse": true,
            "domainMid": 0,
            "domain": [-1.3, 1.4]
          },
          "legend": {
            "title": "vs national avg (°C)",
            "orient": "top-left",
            "format": "+.1f"
          }
        },
        "tooltip": [
          {"field": "Station", "type": "nominal", "title": "City"},
          {"field": "State", "type": "nominal", "title": "State"},
          {"field": "Region", "type": "nominal"},
          {"field": "AvgTemp", "type": "quantitative", "title": "State avg (°C)", "format": ".2f"},
          {"field": "TempDiff", "type": "quantitative", "title": "vs national avg (°C)", "format": "+.2f"}
        ]
      }
    }
  ],
  "config": {
    "view": {"stroke": null},
    "title": {"color": "#38362F"}
  }
}